# ---- Python / 环境 ----
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# ---- 构建中间产物（不进仓库）----
build/
dist/
benchmarks/dist_after.json

# ---- 发布产物 ----
# 安装包（约 57MB）**不进 git 历史**：二进制一旦入库就永久存在，之后每次 clone
# 都要下载。安装包作为 GitHub Release 的附件分发，仓库里只保留 .sha256 校验值
# 与 Release 正文，供他人核对下载完整性。
release/*.exe

# ---- 开发/走查期间的临时工作区 ----
.zwork_todo_build/
.zworktodobuild/
.zwork/
shots_w1/
shots_w3/
shots_w35/
shots_*/
build_logs/
logs/

# ---- 运行时状态与数据（绝不进入仓库）----
*.db
*.db-wal
*.db-shm
*.db-journal
runtime_port.json
migration_state.json
migration_complete.json
state/

# ---- 日志 ----
*.log

# ---- 本机个人配置 / 凭据 / 备份 ----
.env
*.local.json
ai_config.local.json
*credential*
*secret*
*Backup*/
*backup*/
# 注：*.sha256 不再整体忽略——release/ 下的安装包校验值是发布物的一部分。
# 其余位置的 .sha256（如本地临时校验）仍按各自目录规则处理。

# ---- 编辑器 / 系统 ----
.vscode/
.idea/
Thumbs.db
desktop.ini
